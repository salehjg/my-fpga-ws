set_property -dict {PACKAGE_PIN P30 IOSTANDARD LVCMOS18} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN M30 IOSTANDARD LVCMOS18} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN N30 IOSTANDARD LVCMOS18} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN R28 IOSTANDARD LVCMOS18} [get_ports resetn]
set_property -dict {PACKAGE_PIN AA28 IOSTANDARD LVCMOS18} [get_ports default_50mhz_clk0]
set_property -dict {PACKAGE_PIN AH27 IOSTANDARD DIFF_SSTL15} [get_ports sys_diff_clock_clk_p]
set_property -dict {PACKAGE_PIN AH28 IOSTANDARD DIFF_SSTL15} [get_ports sys_diff_clock_clk_n]
create_clock -period 20.000 [get_ports default_50mhz_clk0]
create_clock -period 5.000  [get_ports sys_diff_clock_clk_p]
set_false_path -from [get_ports resetn]
set_false_path -to [get_ports led*]
